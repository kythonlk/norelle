---
---

<footer class="bg-[#181311] text-[#b3a499] pt-16 pb-12 border-t border-[#302520]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-[#29201b]">
      
      <!-- Brand & Mission -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-3">
          <img src="/images/logo.jpg" alt="Norella" class="h-10 w-10 rounded-full border border-[#d4af37]/40" />
          <span class="font-serif-luxury text-2xl tracking-widest text-[#f5ebd9] uppercase">Norella</span>
        </div>
        <p class="text-xs leading-relaxed text-[#9a897e]">
          Dedicated to celebrating eternal South Asian grace through 24K gold radiant skin rituals, handcrafted bridal micro-gold ornaments, and heirloom Kanchipuram silks.
        </p>
        <div class="pt-2 flex items-center gap-3 text-[#d4af37]">
          <span class="text-xs tracking-wider uppercase font-semibold">Colombo Flagship Boutique</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-serif-luxury text-sm tracking-[0.2em] uppercase text-[#f5ebd9] font-bold mb-4">Curated Hauls</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/shop?category=cosmetics-skincare" class="hover:text-[#d4af37] transition-colors">24K Gold Skin Serums</a></li>
          <li><a href="/shop?category=gold-plated-jewellery" class="hover:text-[#d4af37] transition-colors">Bridal Kundan Chokers</a></li>
          <li><a href="/shop?category=indian-sarees" class="hover:text-[#d4af37] transition-colors">Pure Kanchipuram Silk Sarees</a></li>
          <li><a href="/shop" class="hover:text-[#d4af37] transition-colors">Bridal & Trousseau Sets</a></li>
          <li><a href="/shop" class="hover:text-[#d4af37] transition-colors">Limited Festival Editions</a></li>
        </ul>
      </div>

      <!-- Heritage & Trust -->
      <div>
        <h4 class="font-serif-luxury text-sm tracking-[0.2em] uppercase text-[#f5ebd9] font-bold mb-4">Authenticity</h4>
        <ul class="space-y-2.5 text-xs">
          <li><span class="text-[#d4af37]">✓</span> Silk Mark Certified Pure Silk</li>
          <li><span class="text-[#d4af37]">✓</span> 22K/24K Micro-Electroplated Gold</li>
          <li><span class="text-[#d4af37]">✓</span> Hypoallergenic & Nickel-Free</li>
          <li><span class="text-[#d4af37]">✓</span> Islandwide Insured Doorstep Courier</li>
          <li><a href="/about" class="text-[#d4af37] hover:underline">Read Our Craftsmanship Story</a></li>
        </ul>
      </div>

      <!-- Newsletter & Consultation -->
      <div>
        <h4 class="font-serif-luxury text-sm tracking-[0.2em] uppercase text-[#f5ebd9] font-bold mb-4">Bridal Concierge</h4>
        <p class="text-xs text-[#9a897e] mb-3 leading-relaxed">
          Receive private invitations to private viewings and seasonal trousseau releases.
        </p>
        <form class="space-y-2" onsubmit="event.preventDefault(); alert('Thank you for subscribing to the Norella Luxury circle.');">
          <input
            type="email"
            placeholder="Enter your email address"
            required
            class="w-full bg-[#241c18] border border-[#3d2e26] px-3.5 py-2 text-xs text-[#f5ebd9] placeholder-[#7d6c62] rounded focus:outline-none focus:border-[#d4af37]"
          />
          <button
            type="submit"
            class="w-full bg-[#b38f29] hover:bg-[#c9a12e] text-[#181311] py-2 text-xs uppercase font-semibold tracking-widest rounded transition-colors"
          >
            Join Society
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-[#786960] gap-4">
      <p>© {new Date().getFullYear()} Norella Luxury Pvt Ltd. All rights reserved. Sri Lanka.</p>
      <div class="flex items-center space-x-6">
        <a href="/about" class="hover:text-[#d4af37]">Privacy Policy</a>
        <a href="/about" class="hover:text-[#d4af37]">Terms of Service</a>
        <a href="/contact" class="hover:text-[#d4af37]">Showroom Appointments</a>
      </div>
    </div>
  </div>
</footer>
