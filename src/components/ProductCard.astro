---
import type { Product } from '../lib/api';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const primaryImage = product.images?.[0]?.url || '/images/serum.jpg';
const discountAmount = product.compare_at_price && product.compare_at_price > product.price 
  ? product.compare_at_price - product.price 
  : 0;
---

<div class="group bg-white rounded-sm border border-[#ebdcc9] hover:border-[#d4af37] transition-all duration-300 flex flex-col overflow-hidden shadow-xs hover:shadow-xl">
  <!-- Image Frame -->
  <div class="relative aspect-square overflow-hidden bg-[#faf8f5]">
    <a href={`/product/${product.slug}`} class="block w-full h-full">
      <img 
        src={primaryImage} 
        alt={product.title} 
        class="w-full h-full object-cover object-center group-hover:scale-108 transition-transform duration-700 ease-out" 
        loading="lazy"
      />
    </a>

    <!-- Badges -->
    <div class="absolute top-3 left-3 flex flex-col gap-1.5">
      {discountAmount > 0 && (
        <span class="bg-[#2b0c14] text-[#e8ca65] text-[10px] font-bold px-2 py-0.5 rounded-xs tracking-wider uppercase border border-[#d4af37]">
          Save Rs. {discountAmount.toLocaleString()}
        </span>
      )}
      {product.is_featured && (
        <span class="bg-[#120e0b]/90 text-white text-[9px] font-semibold px-2 py-0.5 rounded-xs tracking-wider uppercase">
          Signature
        </span>
      )}
    </div>

    <!-- Quick Action Hover Overlay -->
    <div class="absolute inset-x-3 bottom-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <button 
        onclick={`window.addToCart({ id: '${product.id}', title: '${product.title.replace(/'/g, "\\'")}', price: ${product.price}, image: '${primaryImage}', slug: '${product.slug}', quantity: 1 })`}
        class="w-full py-2.5 bg-[#120e0b]/90 hover:bg-[#2b0c14] text-[#e8ca65] text-xs font-semibold tracking-wider uppercase backdrop-blur-xs border border-[#d4af37] transition-colors flex items-center justify-center gap-2 shadow-lg"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        Quick Add to Bag
      </button>
    </div>
  </div>

  <!-- Content & Details -->
  <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
    <div>
      <div class="flex items-center justify-between text-[11px] text-[#8e7235] uppercase tracking-wider mb-1 font-medium">
        <span>{product.category_name || 'Luxury Collection'}</span>
        <div class="flex items-center text-amber-500">
          <span>★</span>
          <span class="ml-1 text-gray-600 font-semibold">{product.avg_rating || 5.0}</span>
          <span class="text-gray-400 text-[10px] ml-0.5">({product.review_count || 12})</span>
        </div>
      </div>
      <a href={`/product/${product.slug}`} class="block">
        <h3 class="font-cinzel text-sm font-bold text-gray-900 group-hover:text-[#c59b27] transition-colors line-clamp-2">
          {product.title}
        </h3>
      </a>
      <p class="text-xs text-gray-500 mt-1 line-clamp-2">
        {product.short_description}
      </p>
    </div>

    <div class="pt-2 border-t border-gray-100 flex items-center justify-between">
      <div>
        <div class="text-sm font-bold text-gray-900">
          Rs. {product.price.toLocaleString()}
        </div>
        {product.compare_at_price && product.compare_at_price > product.price && (
          <div class="text-xs text-gray-400 line-through">
            Rs. {product.compare_at_price.toLocaleString()}
          </div>
        )}
      </div>

      <a href={`/product/${product.slug}`} class="text-xs font-semibold text-[#8e7235] hover:text-[#2b0c14] tracking-wider uppercase inline-flex items-center">
        Details →
      </a>
    </div>
  </div>
</div>
