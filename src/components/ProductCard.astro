---
import type { Product } from '../lib/api';
interface Props { product: Product; }
const { product } = Astro.props;
const image = product.images?.[0]?.url || '/images/serum.jpg';
const payload = JSON.stringify({ id: product.id, title: product.title, price: product.price, image, slug: product.slug, quantity: 1 });
---
<article class="product-card">
  <a class="product-image" href={`/product/${product.slug}`}><img src={image} alt={product.images?.[0]?.alt_text || product.title} loading="lazy" width="600" height="600" />{product.is_featured && <span class="product-badge">THE SIGNATURE EDIT</span>}</a>
  <div class="product-info"><p class="eyebrow">{product.category_name}</p><a href={`/product/${product.slug}`}><h3>{product.title}</h3></a><p class="product-description">{product.short_description}</p><div class="product-bottom"><div><span>Rs. {product.price.toLocaleString('en-LK')}</span>{product.compare_at_price && product.compare_at_price > product.price && <del>Rs. {product.compare_at_price.toLocaleString('en-LK')}</del>}</div><button type="button" data-add-product={payload} aria-label={`Add ${product.title} to bag`} disabled={product.total_stock === 0}>{product.total_stock === 0 ? 'Sold out' : '+'}</button></div></div>
</article>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-add-product]').forEach(button => button.addEventListener('click', () => {
    (window as any).addToCart(JSON.parse(button.dataset.addProduct!));
  }));
</script>
