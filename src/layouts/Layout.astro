---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Norella | Silks, Jewellery & Everyday Rituals', description = 'Discover a considered collection of Indian sarees, gold-plated jewellery and skincare at Norella Sri Lanka.' } = Astro.props;
const links = [['/shop', 'Shop all'], ['/shop?category=indian-sarees', 'Silk sarees'], ['/shop?category=gold-plated-jewellery', 'Jewellery'], ['/shop?category=cosmetics-skincare', 'Beauty & rituals'], ['/about', 'Our story']];
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="theme-color" content="#4b202d" /><link rel="icon" type="image/jpeg" href="/images/logo.jpg" /><title>{title}</title><meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:image" content="/images/hero-banner.jpg" /></head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="announcement">A little something special, delivered islandwide. <span>Complimentary shipping over Rs. 15,000 ↗</span></div>
    <header class="site-header">
      <div class="header-inner">
        <button id="mobile-menu-btn" class="mobile-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
        <a class="wordmark" href="/" aria-label="Norella home">NORELLA<span>THE ART OF EVERYDAY ELEGANCE</span></a>
        <nav class="desktop-nav" aria-label="Main navigation">{links.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}</nav>
        <div class="header-actions"><a href="/shop#product-search" aria-label="Search collection"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></a><button id="cart-drawer-btn" aria-label="Open shopping bag" aria-haspopup="dialog"><svg width="21" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg><span id="cart-count-badge">0</span></button></div>
      </div>
      <nav id="mobile-menu" class="hidden mobile-nav" aria-label="Mobile navigation">{links.map(([href,label]) => <a href={href}>{label}</a>)}<a href="/contact">Contact</a></nav>
    </header>
    <main id="main-content" class="flex-grow"><slot /></main>
    <p id="cart-status" role="status" class="text-center text-sm"></p>
    <div id="cart-drawer-backdrop" class="fixed inset-0 bg-black/60 z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>
    <aside id="cart-drawer-panel" role="dialog" aria-modal="true" aria-label="Your shopping bag" aria-hidden="true" inert class="fixed top-0 right-0 h-full w-full max-w-md bg-white z-50 shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col">
      <div class="p-6 border-b flex items-center justify-between"><div><h2 class="text-2xl">Your shopping bag</h2><span id="drawer-item-count" class="text-xs text-gray-500">0 items</span></div><button id="cart-close-btn" aria-label="Close shopping bag" class="w-11 h-11 text-2xl">×</button></div>
      <div id="drawer-items-list" class="flex-1 overflow-y-auto p-5 space-y-4 divide-y divide-gray-100"></div>
      <div class="p-6 border-t bg-[#faf8f5] space-y-4"><div class="flex justify-between text-sm"><span>Subtotal</span><span id="drawer-subtotal">Rs. 0</span></div><p class="text-xs text-gray-500">Delivery Rs. 750. Free on orders of Rs. 15,000 or more.</p><a href="/cart" class="primary-link w-full">View bag <span>→</span></a><a href="/checkout" class="block text-center text-xs underline">Continue to checkout</a><button id="clear-cart-btn" class="w-full text-xs text-gray-500 py-2">Clear bag</button></div>
    </aside>
    <footer class="site-footer"><div class="footer-grid"><div><a class="wordmark" href="/">NORELLA<span>THE ART OF EVERYDAY ELEGANCE</span></a><p>A considered collection of beautiful things.<br />Inspired by heritage. Made for your moments.</p><span class="footer-location">Based in Sri Lanka · Curated with care</span></div><div><h2>Explore</h2><a href="/shop?category=indian-sarees">Silk sarees</a><a href="/shop?category=gold-plated-jewellery">Gold jewellery</a><a href="/shop?category=cosmetics-skincare">Beauty & rituals</a><a href="/shop">The full collection</a></div><div><h2>Here to help</h2><a href="/contact">Contact us</a><a href="/contact#delivery">Delivery & returns</a><a href="/about">Our story</a><a href="/cart">Your shopping bag</a></div><div><h2>A more personal touch.</h2><p>Need help finding a piece or putting together a special look?</p><a class="footer-contact" href="/contact">Meet your next favourite ↗</a></div></div><div class="footer-bottom"><p>© {new Date().getFullYear()} Norella. All rights reserved.</p><span>Sri Lanka · LKR</span></div></footer>
    <script is:inline>
      const CART_STORAGE_KEY = 'norella_cart_v1';

      function getCart() {
        try {
          const value = JSON.parse(localStorage.getItem(CART_STORAGE_KEY) || '[]');
          return Array.isArray(value) ? value.filter(item => item && typeof item.id === 'string' && /^[a-zA-Z0-9_-]+$/.test(item.id) && typeof item.title === 'string' && !/[<>"]/.test(item.title) && typeof item.image === 'string' && !/[<>"]/.test(item.image) && (item.image.startsWith('/') || /^https?:\/\//.test(item.image)) && Number.isFinite(item.price) && item.price >= 0 && Number.isInteger(item.quantity) && item.quantity > 0 && item.quantity <= 10) : [];
        } catch {
          return [];
        }
      }

      function saveCart(cart) {
        try { localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart)); } catch { document.getElementById('cart-status').textContent = 'Your browser could not save your bag. Please enable site storage and try again.'; return; }
        updateCartUI();
        window.dispatchEvent(new CustomEvent('norella:cart_updated'));
      }

      window.getNorellaCart = getCart;
      window.changeCartQty = (index, delta) => window.changeQty(getCart()[index]?.id, delta);
      window.removeCartItem = index => window.removeItem(getCart()[index]?.id);
      window.clearNorellaCart = () => saveCart([]);
      window.addEventListener('storage', () => { updateCartUI(); window.dispatchEvent(new CustomEvent('norella:cart_updated')); });
      let previousFocus;
      document.addEventListener('keydown', event => {
        const panel = document.getElementById('cart-drawer-panel');
        if (panel.inert) return;
        if (event.key === 'Escape') closeCartDrawer();
        if (event.key === 'Tab') {
          const focusable = [...panel.querySelectorAll('a[href], button:not([disabled])')];
          const first = focusable[0], last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      });
      window.addToCart = function(product) {
        const cart = getCart();
        const existing = cart.find(item => item.id === product.id);
        if (existing) {
          existing.quantity = Math.min(10, existing.quantity + Math.max(1, Math.min(10, Number(product.quantity) || 1)));
        } else {
          cart.push({
            id: product.id,
            title: product.title,
            price: product.price,
            image: product.image,
            quantity: Math.max(1, Math.min(10, Math.floor(Number(product.quantity) || 1))),
            slug: product.slug
          });
        }
        saveCart(cart);
        openCartDrawer();
      };

      function updateCartUI() {
        const cart = getCart();
        const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
        const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

        const badge = document.getElementById('cart-count-badge');
        if (badge) badge.textContent = String(totalCount);

        const drawerCount = document.getElementById('drawer-item-count');
        if (drawerCount) drawerCount.textContent = `${totalCount} item${totalCount === 1 ? '' : 's'}`;

        const drawerSubtotal = document.getElementById('drawer-subtotal');
        if (drawerSubtotal) drawerSubtotal.textContent = `Rs. ${subtotal.toLocaleString()}`;

        const listContainer = document.getElementById('drawer-items-list');
        if (!listContainer) return;

        if (cart.length === 0) {
          listContainer.innerHTML = `
            <div class="py-12 text-center text-gray-400 space-y-3">
              <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <p class="text-sm font-medium text-gray-600">Your bag is currently empty.</p>
              <a href="/shop" class="inline-block text-xs font-semibold text-[#8e7235] hover:underline uppercase tracking-wider">
                Discover Collections →
              </a>
            </div>
          `;
          return;
        }

        listContainer.innerHTML = cart.map(item => `
          <div class="py-3 flex gap-3 items-center">
            <img src="${item.image}" alt="${item.title}" class="w-16 h-16 object-cover rounded-sm border border-gray-200" />
            <div class="flex-1 min-w-0">
              <h5 class="text-xs font-medium text-gray-900 truncate">${item.title}</h5>
              <div class="text-xs text-[#8e7235] font-semibold mt-1">Rs. ${item.price.toLocaleString()}</div>
              <div class="flex items-center gap-2 mt-2">
                <button onclick="changeQty('${item.id}', -1)" class="w-6 h-6 border rounded-sm flex items-center justify-center text-gray-600 hover:bg-gray-100 text-xs">-</button>
                <span class="text-xs font-medium px-2">${item.quantity}</span>
                <button onclick="changeQty('${item.id}', 1)" class="w-6 h-6 border rounded-sm flex items-center justify-center text-gray-600 hover:bg-gray-100 text-xs">+</button>
                <button onclick="removeItem('${item.id}')" class="text-xs text-red-500 hover:text-red-700 ml-auto">Remove</button>
              </div>
            </div>
          </div>
        `).join('');
      }

      window.changeQty = function(id, delta) {
        let cart = getCart();
        const item = cart.find(i => i.id === id);
        if (item) {
          item.quantity = Math.min(10, item.quantity + delta);
          if (item.quantity <= 0) {
            cart = cart.filter(i => i.id !== id);
          }
          saveCart(cart);
        }
      };

      window.removeItem = function(id) {
        let cart = getCart();
        cart = cart.filter(i => i.id !== id);
        saveCart(cart);
      };

      function openCartDrawer() {
        const backdrop = document.getElementById('cart-drawer-backdrop');
        const panel = document.getElementById('cart-drawer-panel');
        if (backdrop && panel) {
          previousFocus = document.activeElement;
          panel.inert = false;
          panel.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          document.getElementById('cart-close-btn').focus();
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100');
          panel.classList.remove('translate-x-full');
          panel.classList.add('translate-x-0');
        }
      }

      function closeCartDrawer() {
        const backdrop = document.getElementById('cart-drawer-backdrop');
        const panel = document.getElementById('cart-drawer-panel');
        if (backdrop && panel) {
          panel.inert = true;
          panel.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          previousFocus?.focus();
          backdrop.classList.add('opacity-0', 'pointer-events-none');
          backdrop.classList.remove('opacity-100');
          panel.classList.add('translate-x-full');
          panel.classList.remove('translate-x-0');
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        updateCartUI();

        document.getElementById('cart-drawer-btn')?.addEventListener('click', openCartDrawer);
        document.getElementById('cart-close-btn')?.addEventListener('click', closeCartDrawer);
        document.getElementById('cart-drawer-backdrop')?.addEventListener('click', closeCartDrawer);

        document.getElementById('clear-cart-btn')?.addEventListener('click', () => {
          saveCart([]);
        });

        // Mobile menu toggle
        const mobBtn = document.getElementById('mobile-menu-btn');
        const mobMenu = document.getElementById('mobile-menu');
        mobBtn?.addEventListener('click', () => {
          mobMenu?.classList.toggle('hidden');
          mobBtn.setAttribute('aria-expanded', String(!mobMenu.classList.contains('hidden')));
        });

        // Newsletter handler
        const newsForm = document.getElementById('newsletter-form');
        newsForm?.addEventListener('submit', (e) => {
          e.preventDefault();
          const alertBox = document.getElementById('newsletter-success');
          if (alertBox) {
            alertBox.classList.remove('hidden');
            newsForm.reset();
          }
        });
      });
    </script>

  </body>
</html>
