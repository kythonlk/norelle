---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Norella Sri Lanka">
  <div class="max-w-4xl mx-auto px-4 py-24 sm:py-32 text-center">
    <span class="text-xs font-semibold uppercase tracking-[0.3em] text-[#8e7235]">Error 404</span>
    <h1 class="font-cinzel text-4xl sm:text-5xl font-bold text-gray-900 mt-4">Page Not Found</h1>
    <p class="mt-4 text-sm sm:text-base text-gray-600 max-w-md mx-auto leading-relaxed">
      The piece or page you are looking for is no longer available or the link may be incorrect.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/"
        class="inline-block py-3 px-8 bg-[#120e0b] hover:bg-[#2b0c14] text-[#e8ca65] font-semibold text-xs uppercase tracking-widest transition-colors shadow-md border border-[#d4af37]"
      >
        Return to Atelier
      </a>
      <a
        href="/shop"
        class="inline-block py-3 px-8 bg-transparent hover:bg-gray-100 text-gray-800 font-semibold text-xs uppercase tracking-widest transition-colors border border-[#ebdcc9]"
      >
        Explore Collection
      </a>
    </div>
  </div>
</Layout>
