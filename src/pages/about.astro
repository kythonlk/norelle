---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Atelier & Heritage | Norella Sri Lanka">
  <div class="relative bg-[#0d0a08] text-white py-20 border-b border-[#2a2219] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.3em] text-[#e8ca65]">The Essence of Luxury</span>
      <h1 class="font-cinzel text-4xl sm:text-5xl font-bold mt-2">The Norella Atelier</h1>
      <p class="mt-4 max-w-2xl mx-auto text-gray-300 text-sm font-playfair italic">
        Crafting unmatched opulence through centuries of South Asian royal handloom and artisanal jewellery traditions.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <img src="/images/hero-banner.jpg" alt="Norella Story" class="rounded-sm shadow-xl border border-[#d4af37]" />
      <div class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-[#8e7235]">Our Heritage</span>
        <h2 class="font-cinzel text-2xl font-bold text-gray-900">Born in Colombo, Inspired by Imperial Dynasties</h2>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-light">
          Norella was established to bring high-end South Asian haute couture and heirloom bridal splendour directly to discerning connoisseurs in Sri Lanka.
        </p>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-light">
          We bridge master weavers in Kanchipuram and Varanasi with master goldsmiths specializing in 22K micron-plated temple jewellery, creating timeless pieces made to be passed down generations.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center pt-8 border-t border-gray-200">
      <div class="p-6 bg-white rounded-sm border border-[#ebdcc9] space-y-2">
        <div class="text-2xl text-[#8e7235]">👑</div>
        <h3 class="font-cinzel text-base font-bold text-gray-900">22K Micro-Gold Micron Layering</h3>
        <p class="text-xs text-gray-500 font-light">Ultra-durable anti-tarnish protective plating resistant to tropical Sri Lankan climates.</p>
      </div>
      <div class="p-6 bg-white rounded-sm border border-[#ebdcc9] space-y-2">
        <div class="text-2xl text-[#8e7235]">🪡</div>
        <h3 class="font-cinzel text-base font-bold text-gray-900">100% Silk Mark Authenticity</h3>
        <p class="text-xs text-gray-500 font-light">Certified pure handloom mulberry silk woven with authentic gold and silver zari threads.</p>
      </div>
      <div class="p-6 bg-white rounded-sm border border-[#ebdcc9] space-y-2">
        <div class="text-2xl text-[#8e7235]">✨</div>
        <h3 class="font-cinzel text-base font-bold text-gray-900">24K Pure Gold Infusions</h3>
        <p class="text-xs text-gray-500 font-light">Cosmetics enriched with authentic 24-karat gold flakes and Kashmiri saffron botanicals.</p>
      </div>
    </div>
  </div>
</Layout>
