---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Review your bag | Norella">
  <section class="section-shell"><p class="eyebrow">ONE STEP CLOSER</p><h1 class="text-4xl mt-3 mb-4">The finishing touches.</h1><p class="text-sm text-gray-600">Review your collection and delivery estimate.</p>
    <div class="grid lg:grid-cols-2 gap-12 mt-10">
      <div><h2 class="text-2xl mb-5">Your selected pieces</h2><div id="checkout-items" class="divide-y divide-gray-200"></div><a class="text-link inline-block mt-6" href="/cart">← Edit your bag</a></div>
      <div class="bg-white border border-[#e5ded3] p-7 self-start"><h2 class="text-2xl mb-6">Order summary</h2><div class="space-y-4 text-sm"><div class="flex justify-between"><span>Subtotal</span><span id="summary-subtotal">Rs. 0</span></div><div class="flex justify-between"><span>Delivery estimate</span><span id="summary-shipping">Rs. 0</span></div><div class="flex justify-between border-t pt-5 text-lg"><span>Total</span><span id="summary-total">Rs. 0</span></div></div><div class="mt-7 p-5 bg-[#faf8f5] text-sm leading-relaxed"><h3 class="text-lg mb-2">Online ordering is coming soon.</h3><p class="text-gray-600">You can explore the sample collection and save your favourites in your bag. Checkout and payments are not available yet. No order has been placed.</p></div><a href="/contact" class="primary-link w-full mt-5">Contact & collection enquiries <span>↗</span></a><p class="text-xs text-gray-500 mt-4">Delivery estimate: Rs. 750, complimentary from Rs. 15,000.</p></div>
    </div>
  </section>
  <script is:inline>
    function renderCheckout() {
      const cart = window.getNorellaCart();
      const container = document.getElementById('checkout-items');
      container.replaceChildren();
      if (!cart.length) {
        const message = document.createElement('p');
        message.className = 'py-8 text-gray-500';
        message.textContent = 'Your bag is empty. Explore the collection to find your next favourite.';
        container.append(message);
      }
      cart.forEach(item => {
        const row = document.createElement('div'); row.className = 'flex items-center gap-4 py-5';
        const img = document.createElement('img'); img.src = item.image; img.alt = item.title; img.className = 'w-20 h-24 object-cover';
        const detail = document.createElement('div'); detail.className = 'flex-1 text-sm';
        const title = document.createElement('p'); title.textContent = item.title;
        const qty = document.createElement('p'); qty.className = 'text-xs text-gray-500 mt-2'; qty.textContent = 'Quantity: ' + item.quantity;
        const price = document.createElement('p'); price.className = 'text-sm'; price.textContent = 'Rs. ' + (item.price * item.quantity).toLocaleString('en-LK');
        detail.append(title, qty); row.append(img, detail, price); container.append(row);
      });
      const subtotal = cart.reduce((sum,item) => sum + item.price * item.quantity, 0);
      const shipping = subtotal && subtotal < 15000 ? 750 : 0;
      document.getElementById('summary-subtotal').textContent = 'Rs. ' + subtotal.toLocaleString('en-LK');
      document.getElementById('summary-shipping').textContent = shipping ? 'Rs. 750' : subtotal ? 'Complimentary' : 'Rs. 0';
      document.getElementById('summary-total').textContent = 'Rs. ' + (subtotal + shipping).toLocaleString('en-LK');
    }
    document.addEventListener('DOMContentLoaded', renderCheckout);
    window.addEventListener('norella:cart_updated', renderCheckout);
  </script>
</Layout>
