---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Boutique & Bridal Concierge | Norella Sri Lanka">
  <div class="bg-[#faf8f5] py-12 border-b border-[#ebdcc9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#8e7235]">Personal Appointments</span>
      <h1 class="font-cinzel text-3xl sm:text-4xl font-bold text-gray-900 mt-2">Boutique & Concierge</h1>
      <p class="text-xs sm:text-sm text-gray-600 mt-2 max-w-xl mx-auto font-light">
        Schedule a bridal consultation at our Colombo 07 atelier or reach out to our customer care team.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 md:grid-cols-2 gap-12">
    <!-- Contact Info -->
    <div class="space-y-6">
      <div class="space-y-2">
        <h3 class="font-cinzel text-lg font-bold text-gray-900">Colombo Flagship Atelier</h3>
        <p class="text-xs text-gray-600 leading-relaxed font-light">
          No. 18/A, Gregory's Road, Cinnamon Gardens,<br />
          Colombo 07, Sri Lanka
        </p>
      </div>

      <div class="space-y-2">
        <h4 class="font-cinzel text-sm font-bold text-gray-900">Direct Inquiries & WhatsApp</h4>
        <p class="text-xs text-gray-600">Concierge Desk: +94 11 268 9012</p>
        <p class="text-xs text-[#8e7235] font-semibold">WhatsApp VIP: +94 77 987 6543</p>
        <p class="text-xs text-gray-600">Email: concierge@norella.lk</p>
      </div>

      <div class="space-y-2">
        <h4 class="font-cinzel text-sm font-bold text-gray-900">Showroom Hours</h4>
        <p class="text-xs text-gray-600">Monday – Saturday: 10:00 AM – 7:30 PM</p>
        <p class="text-xs text-gray-600">Sunday: By Private Bridal Appointment Only</p>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="bg-white p-8 rounded-sm border border-[#ebdcc9] shadow-md space-y-4">
      <h3 class="font-cinzel text-base font-bold text-gray-900">Send an Inquiry</h3>
      <form id="contact-form" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Your Full Name</label>
          <input type="text" required class="w-full border border-gray-300 rounded-sm px-3 py-2 text-xs focus:border-[#d4af37] focus:outline-hidden" placeholder="Kavindi Dissanayake" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Phone Number (Sri Lanka)</label>
          <input type="tel" required class="w-full border border-gray-300 rounded-sm px-3 py-2 text-xs focus:border-[#d4af37] focus:outline-hidden" placeholder="+94 77 ..." />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Inquiry Category</label>
          <select class="w-full border border-gray-300 rounded-sm px-3 py-2 text-xs focus:border-[#d4af37] focus:outline-hidden bg-white">
            <option>Bridal Saree & Jewellery Consultation</option>
            <option>Product & Sizing Inquiry</option>
            <option>Order Tracking & Islandwide Delivery</option>
            <option>Custom Jewellery Order</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Message</label>
          <textarea rows="3" required class="w-full border border-gray-300 rounded-sm px-3 py-2 text-xs focus:border-[#d4af37] focus:outline-hidden" placeholder="Tell us about your requirements..."></textarea>
        </div>
        <button type="submit" class="w-full py-3 bg-[#120e0b] hover:bg-[#2b0c14] text-[#e8ca65] font-semibold text-xs uppercase tracking-widest rounded-sm border border-[#d4af37] transition-colors">
          Submit Inquiry
        </button>
        <div id="contact-success" class="hidden text-xs text-emerald-700 text-center font-medium pt-2">
          Thank you. Our bridal concierge team will reach out within 2 hours.
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('contact-success')?.classList.remove('hidden');
      e.target.reset();
    });
  </script>
</Layout>
