---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../lib/api';
const products = await getProducts();
const collections = [
  { name: 'The silk collection', category: 'indian-sarees', image: 'saree', detail: 'Beautifully woven. Forever treasured.' },
  { name: 'A little golden hour', category: 'gold-plated-jewellery', image: 'jewel', detail: 'Jewellery that makes the moment.' },
  { name: 'Your daily ritual', category: 'cosmetics-skincare', image: 'serum', detail: 'Small moments of care, every day.' },
];
---
<Layout>
  <section class="editorial-hero">
    <img src="/images/hero-banner.jpg" alt="Silk, gold jewellery and beauty from the Norella collection" fetchpriority="high" width="1536" height="1024" />
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <p class="eyebrow">THE NORELLA EDIT · 2026</p>
      <h1>A little luxury.<br />A lasting <em>impression.</em></h1>
      <p>Beautiful silks, golden details, and everyday rituals.<br class="hidden sm:block" /> Thoughtfully brought together, just for you.</p>
      <a href="/shop" class="primary-link">Discover the collection <span>↗</span></a>
      <a href="/about" class="hero-story">A story of timeless craft <span>→</span></a>
    </div>
    <div class="hero-caption"><span>ROOTED IN HERITAGE</span><span>Made for your moments.</span></div>
  </section>
  <div class="service-strip"><span>✧ &nbsp; Thoughtfully curated</span><span>Complimentary delivery over Rs. 15,000</span><span>From our collection to your doorstep</span></div>
  <section class="section-shell">
    <div class="section-heading"><div><p class="eyebrow">THREE WORLDS. ONE NORELLA.</p><h2>Find your kind of beautiful.</h2></div><a class="text-link" href="/shop">Explore all collections ↗</a></div>
    <div class="collection-grid">{collections.map((c, i) => <a class="collection-tile" href={`/shop?category=${c.category}`}><div class="collection-image"><img src={`/images/${c.image}.jpg`} alt={c.name} loading="lazy" width="640" height="640" /><span>0{i + 1}</span></div><div class="collection-caption"><div><h3>{c.name}</h3><p>{c.detail}</p></div><span>↗</span></div></a>)}</div>
  </section>
  <section class="section-shell arrivals-section">
    <div class="section-heading"><div><p class="eyebrow">THE PIECES WE LOVE</p><h2>Meet your next favourites.</h2></div><a class="text-link" href="/shop">Shop the edit ↗</a></div>
    <div class="catalog-grid">{products.slice(0, 4).map(product => <ProductCard product={product} />)}</div>
    <p class="sample-note">Explore our sample collection. Availability and specifications will be confirmed before ordering.</p>
  </section>
  <section class="heritage-section"><div class="heritage-image"><img src="/images/saree.jpg" alt="Emerald silk and intricate gold weaving" loading="lazy" width="640" height="640" /></div><div class="heritage-copy"><p class="eyebrow">A LOVE LETTER TO CRAFT</p><h2>Some things never<br />go out of <em>style.</em></h2><p>The way silk catches the light. The warmth of a golden detail. The quiet joy of getting ready for something special.</p><p>Norella brings together a considered collection inspired by South Asian heritage, and the women who make it their own.</p><a href="/about" class="text-link">Get to know Norella ↗</a></div></section>
  <section class="section-shell occasion-section"><p class="eyebrow">HOW WILL YOU WEAR YOURS?</p><h2>For the everyday. For the unforgettable.</h2><div class="occasion-links"><a href="/shop?category=indian-sarees">The wedding guest edit <span>↗</span></a><a href="/shop?category=gold-plated-jewellery">A gift to remember <span>↗</span></a><a href="/shop?category=cosmetics-skincare">A moment for yourself <span>↗</span></a></div></section>
</Layout>
