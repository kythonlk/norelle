---
import Layout from '../../layouts/Layout.astro';
import { getProducts, type Product } from '../../lib/api';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const primaryImage = product.images?.[0]?.url || '/images/serum.jpg';
const discount = product.compare_at_price && product.compare_at_price > product.price
  ? product.compare_at_price - product.price
  : 0;
---

<Layout title={`${product.title} | Norella Luxury Sri Lanka`} description={product.short_description}>
  <!-- Breadcrumbs -->
  <div class="bg-[#faf8f5] border-b border-[#ebdcc9] py-3 text-xs text-gray-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-[#8e7235]">Home</a>
      <span>/</span>
      <a href="/shop" class="hover:text-[#8e7235]">Shop</a>
      <span>/</span>
      <span class="text-gray-900 font-medium truncate max-w-xs">{product.title}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Media Gallery -->
      <div class="space-y-4">
        <div class="aspect-square bg-white rounded-sm border border-[#ebdcc9] overflow-hidden shadow-md relative group">
          <img 
            id="main-product-img"
            src={primaryImage} 
            alt={product.title} 
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
          />
          {discount > 0 && (
            <span class="absolute top-4 left-4 bg-[#2b0c14] text-[#e8ca65] text-xs font-bold px-3 py-1 rounded-xs tracking-wider uppercase border border-[#d4af37]">
              Save Rs. {discount.toLocaleString()}
            </span>
          )}
        </div>
      </div>

      <!-- Product Information -->
      <div class="space-y-6">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#8e7235]">
            {product.category_name || 'Norella Luxury Collection'}
          </span>
          <h1 class="font-cinzel text-2xl sm:text-3xl font-bold text-gray-900 mt-2">
            {product.title}
          </h1>
          <p class="text-xs text-gray-500 mt-3 leading-relaxed">Sample collection · Image is illustrative. Final availability and specifications require confirmation.</p>
        </div>

        <!-- Pricing -->
        <div class="p-4 bg-[#faf8f5] rounded-sm border border-[#ebdcc9] flex items-baseline gap-4">
          <span class="font-cinzel text-3xl font-bold text-gray-900">
            Rs. {product.price.toLocaleString()}
          </span>
          {product.compare_at_price && (
            <span class="text-base text-gray-400 line-through">
              Rs. {product.compare_at_price.toLocaleString()}
            </span>
          )}
          <span class="ml-auto text-[11px] text-gray-500">
            Includes all Sri Lanka taxes
          </span>
        </div>

        <!-- Short Description -->
        <p class="text-sm text-gray-600 leading-relaxed font-light">
          {product.short_description}
        </p>

        <!-- Quantity & Add to Cart -->
        <div class="space-y-4 pt-4 border-t border-gray-100">
          <div class="flex items-center gap-4">
            <label class="text-xs font-semibold uppercase tracking-wider text-gray-700">Quantity</label>
            <div class="flex items-center border border-gray-300 rounded-sm">
              <button id="qty-dec" class="w-10 h-10 flex items-center justify-center text-gray-600 hover:bg-gray-100">-</button>
              <input id="product-qty" type="number" value="1" min="1" max="10" class="w-12 h-10 text-center text-sm font-semibold border-x border-gray-300 focus:outline-hidden" />
              <button id="qty-inc" class="w-10 h-10 flex items-center justify-center text-gray-600 hover:bg-gray-100">+</button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <button 
              id="add-to-cart-action"
              class="py-4 px-6 bg-[#120e0b] hover:bg-[#2b0c14] text-[#e8ca65] font-semibold text-xs uppercase tracking-widest transition-colors shadow-lg border border-[#d4af37] flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              Add to Shopping Bag
            </button>
            <a 
              href="/checkout"
              onclick={`window.addToCart({ id: '${product.id}', title: '${product.title.replace(/'/g, "\\'")}', price: ${product.price}, image: '${primaryImage}', slug: '${product.slug}', quantity: 1 })`}
              class="py-4 px-6 bg-gradient-to-r from-[#c59b27] to-[#aa771c] hover:opacity-95 text-white font-semibold text-xs uppercase tracking-widest text-center transition-opacity shadow-lg flex items-center justify-center"
            >
              Review your bag
            </a>
          </div>
        </div>

        <!-- Value Guarantees -->
        <div class="p-4 border border-[#ebdcc9] bg-white rounded-sm grid grid-cols-2 gap-3 text-xs text-gray-700">
          <div class="flex items-center gap-2">
            <span class="text-[#c59b27]">✔</span>
            <span>Thoughtfully curated collection</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#c59b27]">✔</span>
            <span>Inspired by traditional craft</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#c59b27]">✔</span>
            <span>Delivery estimate at checkout</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#c59b27]">✔</span>
            <span>Save favourites in your bag</span>
          </div>
        </div>

        <!-- Long Description Tabs -->
        <div class="pt-6 border-t border-gray-200">
          <h3 class="font-cinzel text-base font-bold text-gray-900 mb-3">Artisan Craft & Description</h3>
          <div class="prose prose-sm text-xs text-gray-600 leading-relaxed font-light" set:html={product.description} />
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ product, primaryImage }}>
    const qtyInput = document.getElementById('product-qty');
    document.getElementById('qty-dec')?.addEventListener('click', () => {
      let val = parseInt(qtyInput.value) || 1;
      if (val > 1) qtyInput.value = val - 1;
    });
    document.getElementById('qty-inc')?.addEventListener('click', () => {
      let val = parseInt(qtyInput.value) || 1;
      if (val < 10) qtyInput.value = val + 1;
    });

    document.getElementById('add-to-cart-action')?.addEventListener('click', () => {
      const qty = parseInt(qtyInput.value) || 1;
      window.addToCart({
        id: product.id,
        title: product.title,
        price: product.price,
        image: primaryImage,
        slug: product.slug,
        quantity: qty
      });
    });
  </script>
</Layout>
