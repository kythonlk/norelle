---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../lib/api';

const products = await getProducts();
---

<Layout title="Curated Shop | Norella Luxury Cosmetics, Jewellery & Sarees">
  <div class="bg-[#faf8f5] py-10 border-b border-[#ebdcc9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#8e7235]">The Catalog</span>
      <h1 class="font-cinzel text-3xl sm:text-4xl font-bold text-gray-900 mt-1">Curated Collections</h1>
      <p class="text-xs sm:text-sm text-gray-600 mt-2 max-w-2xl font-light">
        Explore 100% authentic handcrafted pieces, gold-infused formulations, and pure handwoven silk sarees.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap gap-2 text-xs font-semibold tracking-wider uppercase">
        <button onclick="filterCategory('all')" class="cat-filter-btn active px-4 py-2 bg-[#120e0b] text-[#e8ca65] rounded-xs border border-[#d4af37]">
          All Items ({products.length})
        </button>
        <button onclick="filterCategory('cosmetics-skincare')" class="cat-filter-btn px-4 py-2 bg-white text-gray-700 hover:bg-[#120e0b] hover:text-[#e8ca65] rounded-xs border border-gray-200 transition-colors">
          Cosmetics & Glow
        </button>
        <button onclick="filterCategory('gold-plated-jewellery')" class="cat-filter-btn px-4 py-2 bg-white text-gray-700 hover:bg-[#120e0b] hover:text-[#e8ca65] rounded-xs border border-gray-200 transition-colors">
          22K Gold Jewellery
        </button>
        <button onclick="filterCategory('indian-sarees')" class="cat-filter-btn px-4 py-2 bg-white text-gray-700 hover:bg-[#120e0b] hover:text-[#e8ca65] rounded-xs border border-gray-200 transition-colors">
          Indian Silk Sarees
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Grid -->
    <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map(product => (
        <div class="product-item-wrapper" data-category={product.category_slug}>
          <ProductCard product={product} />
        </div>
      ))}
    </div>

    <!-- Zero Results Message -->
    <div id="no-products-msg" class="hidden py-20 text-center text-gray-500">
      <p class="text-base font-cinzel">No pieces found in this category.</p>
      <button onclick="filterCategory('all')" class="mt-3 text-xs font-semibold text-[#8e7235] hover:underline uppercase">
        View All Items
      </button>
    </div>
  </div>

  <script is:inline>
    function filterCategory(categorySlug) {
      const items = document.querySelectorAll('.product-item-wrapper');
      const buttons = document.querySelectorAll('.cat-filter-btn');
      let visibleCount = 0;

      buttons.forEach(btn => {
        btn.classList.remove('bg-[#120e0b]', 'text-[#e8ca65]', 'border-[#d4af37]');
        btn.classList.add('bg-white', 'text-gray-700');
        if (btn.getAttribute('onclick')?.includes(categorySlug)) {
          btn.classList.add('bg-[#120e0b]', 'text-[#e8ca65]', 'border-[#d4af37]');
          btn.classList.remove('bg-white', 'text-gray-700');
        }
      });

      items.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (categorySlug === 'all' || itemCat === categorySlug) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      const noMsg = document.getElementById('no-products-msg');
      if (noMsg) {
        if (visibleCount === 0) noMsg.classList.remove('hidden');
        else noMsg.classList.add('hidden');
      }
    }

    // Auto filter based on URL query param
    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const cat = params.get('category');
      if (cat) filterCategory(cat);
    });
  </script>
</Layout>
